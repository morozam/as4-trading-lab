<?xml version='1.0' encoding='UTF-8'?>
<PMode xmlns="http://holodeck-b2b.org/schemas/2014/10/pmode">
  <id>mvp-reverse</id>
  <mep>http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/ns/core/200704/oneWay</mep>
  <mepBinding>http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/ns/core/200704/push</mepBinding>
  <Initiator>
    <PartyId>urn:nomination-lab:party:b</PartyId>
    <Role>Sender</Role>
    <SecurityConfiguration>
      <Signing>
        <KeystoreAlias>partyb</KeystoreAlias>
        <KeyReferenceMethod>IssuerSerial</KeyReferenceMethod>
        <Algorithm>http://www.w3.org/2001/04/xmldsig-more#rsa-sha256</Algorithm>
      </Signing>
    </SecurityConfiguration>
  </Initiator>
  <Responder>
    <PartyId>urn:nomination-lab:party:a</PartyId>
    <Role>Receiver</Role>
    <SecurityConfiguration>
      <Signing>
        <KeystoreAlias password="ExampleA">partya</KeystoreAlias>
        <KeyReferenceMethod>IssuerSerial</KeyReferenceMethod>
        <Algorithm>http://www.w3.org/2001/04/xmldsig-more#rsa-sha256</Algorithm>
      </Signing>
      <Encryption>
        <KeystoreAlias password="ExampleA">partya</KeystoreAlias>
        <Algorithm>http://www.w3.org/2009/xmlenc11#aes128-gcm</Algorithm>
        <KeyTransport>
          <Algorithm>http://www.w3.org/2009/xmlenc11#rsa-oaep</Algorithm>
          <MGFAlgorithm>http://www.w3.org/2009/xmlenc11#mgf1sha256</MGFAlgorithm>
          <DigestAlgorithm>http://www.w3.org/2001/04/xmlenc#sha256</DigestAlgorithm>
          <KeyReferenceMethod>IssuerSerial</KeyReferenceMethod>
        </KeyTransport>
      </Encryption>
    </SecurityConfiguration>
  </Responder>
  <Agreement>
    <name>urn:nomination-lab:agreement:v1</name>
  </Agreement>
  <Leg>
    <Receipt>
      <ReplyPattern>RESPONSE</ReplyPattern>
    </Receipt>
    <DefaultDelivery>
      <DeliveryMethod>org.holodeckb2b.backend.rest.NotifyAndDeliverOperation</DeliveryMethod>
      <Parameter>
        <name>URL</name>
        <value>http://127.0.0.1:8787</value>
      </Parameter>
      <Parameter>
        <name>TIMEOUT</name>
        <value>10000</value>
      </Parameter>
      <Parameter>
        <name>SIGNAL_WITH_CONVID</name>
        <value>true</value>
      </Parameter>
    </DefaultDelivery>
    <UserMessageFlow>
      <BusinessInfo>
        <Action>ConfirmNomination</Action>
        <Service>
          <name>urn:nomination-lab:service:v1</name>
        </Service>
      </BusinessInfo>
      <ErrorHandling>
        <NotifyErrorToBusinessApplication>true</NotifyErrorToBusinessApplication>
      </ErrorHandling>
      <PayloadProfile>
        <UseAS4Compression>true</UseAS4Compression>
      </PayloadProfile>
    </UserMessageFlow>
  </Leg>
</PMode>
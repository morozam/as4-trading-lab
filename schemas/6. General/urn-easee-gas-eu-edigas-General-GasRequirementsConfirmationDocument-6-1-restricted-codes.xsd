	</xsd:simpleType>
	<xsd:simpleType name="GasDirectionCodeTypeCodeList">
		<xsd:union memberTypes="StandardRestrictedGasDirectionCodeTypeCodeList LocalRestrictedGasDirectionCodeTypeCodeList"/>
	</xsd:simpleType>
	<!-- ReasonCode type-->	
	<xsd:simpleType name="StandardRestrictedReasonCodeTypeCodeList">
		<xsd:restriction base="ecl:StandardReasonCodeTypeCodeList">
			<xsd:enumeration value="85G"/>
			<xsd:enumeration value="86G"/>
			<xsd:enumeration value="87G"/>					
			<xsd:enumeration value="88G"/>								

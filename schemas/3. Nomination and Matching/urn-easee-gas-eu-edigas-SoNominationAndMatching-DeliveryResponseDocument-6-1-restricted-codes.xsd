			<xsd:enumeration value="12G"/>			
			<xsd:enumeration value="14G"/>
			<xsd:enumeration value="16G"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="BusinessCodeTypeCodeList">
		<xsd:union memberTypes="StandardRestrictedBusinessCodeTypeCodeList LocalRestrictedBusinessCodeTypeCodeList"/>
	</xsd:simpleType>
	<!-- CodingScheme type-->
	<xsd:simpleType name="StandardRestrictedCodingSchemeCodeTypeCodeList">
